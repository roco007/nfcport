# Runtime
NODE_ENV=development
SERVICE_NAME=nfcport-backend
SERVICE_VERSION=2.0.0
HOST=0.0.0.0
PORT=3002
LOG_LEVEL=debug
TRUST_PROXY_HOPS=0

# Browser clients must match one of these exact origins. Native clients do not
# send an Origin header and are unaffected by CORS.
# For Expo web over LAN, append its exact origin using the Mac's current IP,
# for example http://192.168.0.105:8081.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Required for POST /api/nfc-config. Use at least 32 random characters.
ADMIN_API_KEY=change-me

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=nfcport
# Required. Leave this blank until you provide the real database password.
MYSQL_PASSWORD=
MYSQL_DATABASE=nfcPort
# Use "required" outside local development. Production refuses "disabled".
MYSQL_SSL_MODE=disabled
# Optional base64-encoded PEM CA certificate for a private database CA.
# MYSQL_SSL_CA_BASE64=
MYSQL_CONNECTION_LIMIT=10
MYSQL_QUEUE_LIMIT=100
DATABASE_QUERY_TIMEOUT_MS=5000

# Service limits
DEFAULT_USER_NAME=rc007
NFC_CONFIG_BODY_LIMIT_BYTES=1048576
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
WRITE_RATE_LIMIT_MAX=20
READINESS_TIMEOUT_MS=2000
READINESS_CACHE_MS=1000
SHUTDOWN_TIMEOUT_MS=10000
